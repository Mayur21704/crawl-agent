# ==========================================
# AGENT CONFIGURATION & SECRETS
# ==========================================

# 1. Google AI Studio API Key (100% Free Tier: 1,500 requests/day)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Email Notifications (Nodemailer SMTP)
# For Gmail: use your email and an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# The email address where the Scout completion review alert is sent
NOTIFICATION_EMAIL=your_email@gmail.com

# 3. Web Dashboard Server Port & Host URL
PORT=3000
BASE_URL=http://localhost:3000
